## count how many tokens

import pandas as pd
import tiktoken

df = pd.read_parquet("data/lacerda_clean.parquet")

tokenizer = tiktoken.encoding_for_model("gpt-4o")

def count_tokens(text):
    return len(tokenizer.encode(text))
  
df["tokens"] = df["julgado"].apply(count_tokens)

df["tokens"].describe()

