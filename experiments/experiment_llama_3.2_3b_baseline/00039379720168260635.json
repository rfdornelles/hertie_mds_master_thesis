Aqui está o código em Python para extrair as informações da sentença:

```python
import re

def extrair_informacoes(sentenca):
    # Cabeçalho
    cabecalho = re.search(r'Vistos|SENTENÇA', sentenca, re.IGNORECASE)
    if cabecalho:
        return {
            'processo': re.search(r'\d{8}\.\d{2}\.\d{2}\.\d{4}\s\d{4}', sentenca).group(),
            'juiz': re.search(r'Dr\. WALDIR CALCIOLARI', sentenca).group(),
           'sexo_juiz': re.search(r'Masculino|Feminino', sentenca).group()
        }

    # Relatório
    relatorio = re.search(r'Relatório: (.*?)', sentenca, re.DOTALL)
    if relatorio:
        return {
            'nome': re.search(r'MYCHELLE CYPRIANO LOPES', relatorio.group(1)).group(),
            'local': re.search(r'Vila Formosa', relatorio.group(1)).group()
        }

    # Fundamentação
    fundamentacao = re.search(r'Fundamentação: (.*?)', sentenca, re.DOTALL)
    if fundamentacao:
        return {
           'maconha': re.search(r'12 pinos plásticos e 2 pequenos sacos plásticos contendo cocaína', fundamentacao.group(1)).group(),
           'maconha_g': re.search(r'12', fundamentacao.group(1)).group(),
           'maconha_outras': re.search(r'37 g de Cannabis Sativa L', fundamentacao.group(1)).group(),
            'cocaina': re.search(r'12 pinos plásticos e 2 pequenos sacos plásticos contendo cocaína', fundamentacao.group(1)).group(),
            'cocaina_g': re.search(r'12', fundamentacao.group(1)).group(),
            'crack': re.search(r'Nenhuma menção a crack', sentenca).group(),
            'crack_g': re.search(r'Nenhuma menção a crack', sentenca).group(),
            'ecstasy': re.search(r'Nenhuma menção a ecstasy', sentenca).group(),
            'ecstasy_g': re.search(r'Nenhuma menção a ecstasy', sentenca).group(),
            'lsd': re.search(r'Nenhuma menção a LSD', sentenca).group(),
            'lsd_g': re.search(r'Nenhuma menção a LSD', sentenca).group()
        }

    # Parte dispositiva
    parte_dispositiva = re.search(r'Parte dispositiva: (.*?)', sentenca, re.DOTALL)
    if parte_dispositiva:
        return {
           'sentenca': re.search(r'DESCLASSIFICAR a imputação originária capitulada no artigo 33, "caput", da Lei nº 11.343/06', parte_dispositiva.group(1)).group(),
            'pena_base': re.search(r'8 anos e 6 meses', parte_dispositiva.group(1)).group(),
            'tot_pen': re.search(r'8 anos e 6 meses', parte_dispositiva.group(1)).group(),
            'tot_pen_meses': re.search(r'8 anos e 6 meses', parte_dispositiva.group(1)).group()
        }

    # Outras informações
    outras_informacoes = re.search(r'Outras informações: (.*?)', sentenca, re.DOTALL)
    if outras_informacoes:
        return {
            'flag_local_de_trafico': re.search(r'Vila Formosa', outras_informacoes.group(1)).group(),
            'flag_preso_no_momento_da_sentenca': re.search(r'Foi presa em flagrante delito', outras_informacoes.group(1)).group(),
            'flag_confissao_informal': re.search(r'Ficou com vergonha de admitir que era usuária de drogas', outras_informacoes.group(1)).group(),
            'flag_confissao': re.search(r'Foi flagrada na situação de compra das substâncias', outras_informacoes.group(1)).group(),
            'flag_denuncia_anonima': re.search(r'Nenhuma menção a denúncia anônima', sentenca).group(),
            'flag_denuncia': re.search(r'Denúncia formal', outras_informacoes